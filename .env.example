# Copy to .env and fill in what you need. Everything is optional.

# Turns on AI titles, captions, hashtags and menu/loading-screen filtering.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Claude model and effort used for clip enrichment.
CLIPWIZARD_CLAUDE_MODEL=claude-opus-5-5
CLIPWIZARD_CLAUDE_EFFORT=low
# Only the top N highlights per video are sent to Claude.
CLIPWIZARD_AI_MAX_HIGHLIGHTS=15
# Set to off to disable AI even when a key is present.
CLIPWIZARD_AI=on

# Speech model for auto captions (tiny/base/small/medium). Downloaded on first use.
CLIPWIZARD_WHISPER_MODEL=base

# Delete sessions idle for this many days (0 = keep forever). Recommended on public servers.
CLIPWIZARD_RETENTION_DAYS=0
# Longest VOD that can be imported from a link.
CLIPWIZARD_MAX_IMPORT_HOURS=6

# Where uploads, renders and the database live.
CLIPWIZARD_DATA_DIR=./data
# Max upload size in MB.
CLIPWIZARD_MAX_UPLOAD_MB=8192
# Per-workspace limits for public servers (0 = unlimited).
CLIPWIZARD_MAX_ACTIVE_VIDEOS=3
CLIPWIZARD_MAX_ACTIVE_RENDERS=12
CLIPWIZARD_WORKSPACE_QUOTA_GB=0

# Parallel background jobs (analysis + rendering). ffmpeg is CPU heavy.
CLIPWIZARD_WORKERS=2
# Optional TTF font for burned-in titles.
# CLIPWIZARD_FONT=/path/to/font.ttf
# Comma-separated origins, only needed if the UI is served from another domain.
# CLIPWIZARD_CORS_ORIGINS=https://clipwizard.example.com
